{
  "name": "@silku/marketing-hq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/patch-dashboard.js && node scripts/patch-main.js && npm run test:control-plane && npm run test:execution-center && npm run test:persistence",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:control-plane": "tsx scripts/test-control-plane.ts",
    "test:execution-center": "tsx scripts/test-execution-center.ts",
    "test:persistence": "tsx scripts/test-persistence.ts"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.0"
  }
}
