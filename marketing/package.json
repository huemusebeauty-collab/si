{
  "name": "@silku/marketing-hq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/patch-dashboard.js && node scripts/patch-main.js && npm run test:control-plane && npm run test:execution-center && npm run test:persistence && npm run test:persistence-e2e && npm run test:domain-store && npm run test:restart-recovery && npm run test:durable-lifecycle && npm run test:domain-api && npm run test:phase2-e2e && npm run test:website-actions && npm run test:director-website",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:control-plane": "tsx scripts/test-control-plane.ts",
    "test:execution-center": "tsx scripts/test-execution-center.ts",
    "test:persistence": "tsx scripts/test-persistence.ts",
    "test:persistence-e2e": "tsx scripts/test-persistence-e2e.ts",
    "test:domain-store": "tsx scripts/test-domain-store.ts",
    "test:restart-recovery": "tsx scripts/test-restart-recovery.ts",
    "test:durable-lifecycle": "tsx scripts/test-durable-lifecycle.ts",
    "test:domain-api": "tsx scripts/test-domain-api.ts",
    "test:phase2-e2e": "tsx scripts/test-phase2-e2e.ts",
    "test:website-actions": "tsx scripts/test-website-opportunity-actions.ts",
    "test:director-website": "tsx scripts/test-marketing-director-website.ts"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.0"
  }
}
